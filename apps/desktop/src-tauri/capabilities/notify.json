  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notify",
  "description": "Minimal capability for litechat notification toast webview",
  "webviews": ["teza-notify"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
