{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "litechat",
  "version": "0.1.0",
  "identifier": "net.litechat.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "litechat",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQUMwMzFERUQ1QjMyMTQKUldRVU1sdnRIUU9zUDVySm8wSVgvd3FVZW1JY1FzNlVoSnAzeWp0bjR1VjVVYkxTL21YNGZNSWsK",
      "endpoints": [
        "https://github.com/NguoiHaiPhong/litechat/releases/latest/download/latest.json"
      ]
    }
  }
}
